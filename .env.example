# Copy to .env and fill in to enable generated answers and/or real semantic embeddings.
# Without a key, the demo still runs fully offline (hash embeddings + extractive answers).

# Claude answers (pip install anthropic). Takes priority over OpenAI for generation.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# OpenAI embeddings (+ answers when no Anthropic key is set)
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Retrieval knobs (optional)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
CANDIDATES=10
