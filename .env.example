# Copy to .env and fill in to enable real semantic embeddings + generated answers.
# Without a key, the demo still runs fully offline (hash embeddings + extractive answers).
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Retrieval knobs (optional)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
CANDIDATES=10
